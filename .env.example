# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # solo server-side, NUNCA exponer al cliente

# Resend — https://resend.com/api-keys (dominio verificado en Resend > Domains)
RESEND_API_KEY=
RESEND_FROM_EMAIL=notificaciones@legalneasoft.com

# Casilla del estudio que recibe copia de altas nuevas (abogado/solicitud).
# Si se deja vacía, cae a la del admin hardcodeada en src/lib/constants.ts.
ADMIN_NOTIFICATION_EMAIL=

# Para armar links absolutos en emails y redirectTo de Supabase Auth
# (activar-cuenta / recuperar-password). En Vercel: la URL de producción.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
